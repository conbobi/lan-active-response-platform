# Cloudflare Tunnel Token (Lấy từ Cloudflare Zero Trust: Networks -> Tunnels)
# Điền token của bạn vào đây trước khi chạy docker compose
CLOUDFLARE_TUNNEL_TOKEN=eyJhIjoiODAxOGVkMjhjZWEwMDRmZmIxNGVlYTQwZGIzZTAzNDciLCJ0IjoiOTkwMTMzMjQtMjZjNy00M2E0LWEyYzAtODdlZTcwOTEwMWEyIiwicyI6Ilg5N1BPUVoyZWN3NUxqZ1FDQ0Z3Y2FmLzMvSi85SzlvTVJPMk1FeENyV1U9In0=

# SOC Dashboard Authentication (JWT + Refresh Cookie)
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-random-secret-key-at-least-32-chars
JWT_KEY_ID=v1
JWT_ISSUER=larp-manager
JWT_AUDIENCE=larp-soc-dashboard
CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost","https://edr.alwayready.id.vn"]
REFRESH_COOKIE_SAMESITE=lax
# Set true when served exclusively over HTTPS
# REFRESH_COOKIE_SECURE=true
# Set false once all SOC operators have migrated to username/password login
ALLOW_LEGACY_OPERATOR_TOKENS=true
