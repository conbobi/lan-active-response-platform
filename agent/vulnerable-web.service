[Unit]
Description=Vulnerable Web Application Demo (Victim Server)
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/larp-agent/vulnerable_web
ExecStart=/opt/larp-agent/venv/bin/python -u /opt/larp-agent/vulnerable_web/app.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1
Environment=FLASK_HOST=0.0.0.0
Environment=FLASK_PORT=5000
Environment=VULNERABLE_WEB_DIR=/var/log/vulnerable_web
Environment=WEB_AUTH_LOG=/var/log/vulnerable_web/auth.log
Environment=WEB_ACCESS_LOG=/var/log/vulnerable_web/access.log

[Install]
WantedBy=multi-user.target

